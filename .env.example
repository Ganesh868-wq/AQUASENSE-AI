# AquaSense AI - Environment Configuration Example
# Copy this file to .env and customize as needed.

# Application Security
SECRET_KEY=aquasense_jwt_secret_key_change_in_production_2026_xyz
FLASK_ENV=development
PORT=5000

# Database Configuration
# For PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# If DATABASE_URL is left empty or database is unreachable, AquaSense AI automatically
# uses high-performance local SQLite (aquasense.db) for zero-setup demo!
DATABASE_URL=sqlite:///aquasense.db

# Weather API Configuration
# Optional: OpenWeatherMap API key. If left blank, AquaSense AI uses the
# high-precision Open-Meteo API which requires NO API key and provides live global forecast!
OPENWEATHER_API_KEY=

# IoT & Simulation Settings
ENABLE_IOT_SIMULATOR=true
DEMO_MODE=true
